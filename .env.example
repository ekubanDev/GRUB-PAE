# GRUB-PAE — Root Environment Variables Template
# Company: Tesseract Holdings
#
# Run ./scripts/setup-env.sh to copy all module .env.example files to .env
# Never commit real values. All values prefixed REPLACE_WITH_ must be set before running.

# ─── API SERVER (enatega-multivendor-api-custom) ────────────────────────────

PORT=4000
NODE_ENV=development

# MongoDB Atlas — West Africa cluster recommended
MONGODB_URI=REPLACE_WITH_YOUR_MONGODB_URI

# JWT signing secret — use a 64+ character random string
JWT_SECRET=REPLACE_WITH_YOUR_JWT_SECRET

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=REPLACE_WITH_YOUR_FIREBASE_PRIVATE_KEY

# Paystack — Ghana/West Africa primary payment provider
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY

# Google Maps Platform
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_KEY

# Twilio — SMS OTP (+233 Ghana supported)
TWILIO_ACCOUNT_SID=REPLACE_WITH_YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=REPLACE_WITH_YOUR_TWILIO_PHONE_NUMBER

# SendGrid — transactional email
SENDGRID_API_KEY=REPLACE_WITH_YOUR_SENDGRID_KEY
SENDGRID_FROM_EMAIL=REPLACE_WITH_YOUR_SENDGRID_FROM_EMAIL

# Cloudinary — media/image storage
CLOUDINARY_UPLOAD_URL=REPLACE_WITH_YOUR_CLOUDINARY_URL
CLOUDINARY_API_KEY=REPLACE_WITH_YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_YOUR_CLOUDINARY_API_SECRET

# Sentry — error tracking
SENTRY_DSN=REPLACE_WITH_YOUR_SENTRY_DSN

# ─── ADMIN DASHBOARD (enatega-multivendor-admin) ────────────────────────────

NEXT_PUBLIC_SERVER_URL=http://localhost:4000/
NEXT_PUBLIC_WS_SERVER_URL=ws://localhost:4000/

# ─── CUSTOMER WEB (enatega-multivendor-web) ─────────────────────────────────

# NEXT_PUBLIC_SERVER_URL=http://localhost:4000/
# NEXT_PUBLIC_WS_SERVER_URL=ws://localhost:4000/

# ─── MOBILE APPS ─────────────────────────────────────────────────────────────
# Mobile apps use environment.js / environment.ts — not .env files.
# See docs/ENV_SETUP.md for mobile app configuration.
# Replace google-services.json in all 3 mobile modules with GRUB-PAE Firebase project.
